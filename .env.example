# SK AutoSphere Environment Variables

# Supabase Configuration
# Get these from: https://supabase.com/docs/guides/api
NEXT_PUBLIC_SUPABASE_URL=https://<your-supabase-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini AI
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash Redis (for caching AI translations)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_URL=your_upstash_redis_url_here
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# Optional: Stripe (for Phase 3 - Escrow/Payments)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Optional: Shipping API (for Phase 3)
# SHIPPING_API_KEY=your_shipping_api_key

# Development
NODE_ENV=development

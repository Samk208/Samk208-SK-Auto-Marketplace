# SK AutoSphere - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Google Gemini AI (for car description generation)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (Database & Authentication)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Upstash Redis (Caching & Rate Limiting)
# Get these from: https://console.upstash.com/
UPSTASH_REDIS_URL=your_upstash_redis_url
UPSTASH_REDIS_TOKEN=your_upstash_redis_token

# Optional: Add if using service role operations
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Set your app URL for production
# NEXT_PUBLIC_APP_URL=https://skautosphere.com
